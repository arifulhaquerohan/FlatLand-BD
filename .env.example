# =============================================================================
#  FlatLand BD - environment configuration
# =============================================================================
#  HOW TO USE (cPanel)
#  1. Copy this file to ".env" in your application root (same folder as wsgi.py).
#  2. Fill in every value marked REQUIRED.
#  3. In cPanel > Setup Python App, click "Restart" after any change.
#
#  Generate strong secrets with:
#      python -c "import secrets; print(secrets.token_hex(32))"
# =============================================================================


# -----------------------------------------------------------------------------
#  1. ADMIN ACCOUNT + CONSOLE URL                                    REQUIRED
# -----------------------------------------------------------------------------
#  ADMIN_PATH is the secret address of your admin console.
#  Do NOT leave it as "admin" - bots scan that path all day.
#  With the value below, your console lives at:  https://xryz.online/console-x7
ADMIN_PATH=console-x7

#  This account is created automatically the first time the app starts.
ADMIN_USERNAME=rohan
ADMIN_EMAIL=arifulhaquerohan@gmail.com
ADMIN_PASSWORD=change-this-to-a-long-password
ADMIN_PHONE=01712458794


# -----------------------------------------------------------------------------
#  2. SECURITY KEYS                                                  REQUIRED
# -----------------------------------------------------------------------------
#  SECRET_KEY signs login sessions. Minimum 32 characters.
#  If you change it, everyone gets logged out (harmless).
SECRET_KEY=

#  DATA_ENCRYPTION_KEY encrypts visitor phone numbers and emails in the
#  database (AES-256-GCM). Minimum 32 characters.
#  WARNING: if you change this later, previously stored contacts become
#  unreadable. Set it once, then keep a backup somewhere safe.
DATA_ENCRYPTION_KEY=


# -----------------------------------------------------------------------------
#  3. CLOUDINARY - image hosting + CDN                            RECOMMENDED
# -----------------------------------------------------------------------------
#  Why: photos are served from Cloudinary's global CDN as WebP, resized on the
#  fly. Pages load fast, your cPanel disk stays empty, and images survive a
#  redeploy. Without it the app still works - photos are saved into
#  frontend/static/uploads/ on this server instead.
#
#  Where to find these: https://console.cloudinary.com  >  Settings  >  API Keys
#  (the Cloud name is shown on the dashboard home, top-left).
#
#  Option A - three separate values (easiest to read):
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

#  Option B - single connection string (paste from Cloudinary "API environment
#  variable"). If this is set, it wins over Option A.
#  Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# CLOUDINARY_URL=

#  Folder inside your Cloudinary account where uploads are stored.
CLOUDINARY_FOLDER=flatlandbd/uploads

#  Largest request the app accepts, in megabytes. Covers all photos in one
#  submit, so keep it comfortably above (photo size x gallery limit).
MAX_UPLOAD_MB=24

#  After filling these in and restarting, open:
#      /console-x7/media   and click "Test connection"
#  A green result means Cloudinary is live.


# -----------------------------------------------------------------------------
#  4. DATABASE
# -----------------------------------------------------------------------------
#  Default: a SQLite file, fine for a small site and needs zero setup.
DATABASE_URL=sqlite:///flatland.db

#  For MySQL created in cPanel > MySQL Databases, use this shape instead:
# DATABASE_URL=mysql+pymysql://cpaneluser_dbuser:PASSWORD@localhost/cpaneluser_dbname

#  Optional: where SQLite and cache files are written. Leave blank to use the
#  app's own instance/ folder, with an automatic /tmp fallback.
# INSTANCE_PATH=


# -----------------------------------------------------------------------------
#  5. HTTPS + COOKIES  (turn these on once your SSL certificate is active)
# -----------------------------------------------------------------------------
TRUST_PROXY=1
FORCE_HTTPS=1
SESSION_COOKIE_SECURE=1
SESSION_COOKIE_SAMESITE=Lax
WTF_CSRF_TIME_LIMIT=7200


# -----------------------------------------------------------------------------
#  6. LISTING + PAGE SIZES
# -----------------------------------------------------------------------------
LISTINGS_PER_PAGE=9
ADMIN_LISTINGS_PER_PAGE=20
ADMIN_DASHBOARD_RECENT_LIMIT=8


# -----------------------------------------------------------------------------
#  7. CACHING + RATE LIMITING                                        OPTIONAL
# -----------------------------------------------------------------------------
PUBLIC_CACHE_TTL=120
PUBLIC_CACHE_TTL_LONG=3600
COMPRESS_MIN_SIZE=500
COMPRESS_LEVEL=6
CACHE_KEY_PREFIX=flatlandbd

#  Only if your host offers Redis. Without it, counters live in memory and
#  reset whenever the app restarts (perfectly fine for a small site).
# REDIS_URL=redis://127.0.0.1:6379/0
# RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379/1


# -----------------------------------------------------------------------------
#  8. EMAIL NOTIFICATIONS                                            OPTIONAL
# -----------------------------------------------------------------------------
#  Leave blank and enquiries simply stay in the admin console.
# MAIL_SERVER=mail.xryz.online
# MAIL_PORT=587
# MAIL_USE_TLS=1
# MAIL_USERNAME=noreply@xryz.online
# MAIL_PASSWORD=
# MAIL_DEFAULT_SENDER=noreply@xryz.online


# -----------------------------------------------------------------------------
#  9. MAINTENANCE NOTICE
# -----------------------------------------------------------------------------
#  Set to 1 to show a small "scheduled maintenance" banner that slides in after
#  load and removes itself automatically (once per browser session).
#  Set to 0 to disable it completely.
MAINTENANCE_NOTICE=1


# -----------------------------------------------------------------------------
#  10. SEO / SOCIAL SHARING
# -----------------------------------------------------------------------------
# DEFAULT_OG_IMAGE=https://res.cloudinary.com/YOUR_CLOUD/image/upload/v1/flatlandbd/og-cover.jpg


# -----------------------------------------------------------------------------
#  11. LOCAL DEVELOPMENT ONLY
# -----------------------------------------------------------------------------
PORT=5001
